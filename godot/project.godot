; FormFactor actual 3D client
; Godot 4.7.2 stable
config_version=5

[application]
config/name="FormFactor 1.133"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1480
window/size/viewport_height=900
window/size/window_width_override=1480
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2

environment/defaults/default_clear_color=Color(0.008, 0.012, 0.015, 1)
